[Unit]
Description=Jarvis double-clap launcher (wakes the app when fully closed)
After=graphical-session.target jarvis-fix-audio.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/Jarvis2/scripts/clap-daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
